# TRACEGRID Environment Configuration
# CyboShield | Rajasthan Police Hackathon 2026 | PS05

# Environment
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (defaults to local SQLite for hackathon evaluation)
DATABASE_URL=sqlite:///./tracegrid.db
# PostgreSQL option: postgresql://postgres:postgres@localhost:5432/tracegrid

# AI Assistant Configuration
# Optional: Provide Gemini or OpenAI API key for extended LLM reasoning
# If not provided, TRACEGRID runs on a deterministic investigative rule engine with zero loss of functionality
GEMINI_API_KEY=
OPENAI_API_KEY=

# Upload Limits
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=csv,xlsx

